# Node 22+ supports: node --env-file=.env server.mjs
# Keep secrets out of Git. Local preview does not send email without these values.
PORT=4173
DEMO_MODE=true
# Set a real HTTPS origin for recovery links and sharing metadata.
SITE_URL=
MAIL_GATEWAY_URL=
MAIL_GATEWAY_TOKEN=
MAIL_FROM=
SUPPORT_EMAIL=
# Business-approved policy links, provided after review by your business.
PRIVACY_POLICY_URL=
TERMS_URL=
